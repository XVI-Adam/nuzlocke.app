# Copy to .env for local development, and set the same variables in Vercel
# (Project → Settings → Environment Variables). Never commit real values.

# Dropbox shared link to Delta's GameSave-<rom sha1>-gameSave file
UNBOUND_SAVE_URL=

# Random secret, at least 32 characters. Generate one with:
#   openssl rand -base64 36
# Enter the same value on the Sync page of each device you use.
UNBOUND_SYNC_KEY=

# ---- Cross-device sync (/devices) ------------------------------------------
# Separate from UNBOUND_SYNC_KEY (it must be a different value). Needed only to
# connect a device without a pairing code, and to erase the synced copy.
# Rotating it does not disconnect existing devices; revoke those on /devices.
#   openssl rand -base64 36
SYNC_SETUP_KEY=

# Private storage: Upstash Redis (Vercel Marketplace → Upstash → Redis,
# connected to this project). The integration sets these for you; either
# naming works. Without them, `vite dev` uses a temporary in-memory store and
# production reports "not configured".
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
