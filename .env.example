# Copy to .env for local development, and set the same variables in Vercel
# (Project → Settings → Environment Variables). Never commit real values.

# Dropbox shared link to Delta's GameSave-<rom sha1>-gameSave file
UNBOUND_SAVE_URL=

# Random secret, at least 32 characters. Generate one with:
#   openssl rand -base64 36
# Enter the same value on the Sync page of each device you use.
UNBOUND_SYNC_KEY=
